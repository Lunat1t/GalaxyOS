# Copy to .env locally. Never commit real credentials.

# Optional Jev / TypeSafe fast decision layer.
# Without this key Galaxy uses the local System-One fallback.
TYPESAFE_API_KEY=

# Optional API-backed model providers.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Optional semantic backend. Default is dependency-free portable embeddings.
GALAXY_EMBEDDING_BACKEND=portable
GALAXY_EMBEDDING_DIMS=384
# For a pre-downloaded local SentenceTransformer model:
# GALAXY_EMBEDDING_BACKEND=sentence-transformers
# GALAXY_EMBEDDING_MODEL=/absolute/path/to/local/model
